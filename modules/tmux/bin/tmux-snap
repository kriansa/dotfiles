#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Save a tmux session to a JSON snapshot and rebuild it later.

`save` records every window/pane of a session — layout, working directories,
zoom/synchronize state, and (for apps with a handler) how to relaunch what was
running. A window hosting a tmux-nest session is recorded with that whole session
inside it, so nests survive a restore too. `restore` recreates the session from
that snapshot on the target server.

Relaunch is pluggable: one AppHandler per app owns detection, state capture, and
relaunch; adding an app is a one-line edit to `restore_handlers`. Stdlib only,
on purpose — no third-party runtime dependencies.
"""

import argparse
import ctypes
import datetime as dt
import json
import logging
import os
import shlex
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Self

log = logging.getLogger("tmux-snap")

SCHEMA_VERSION = 1


# The relaunch registry — the main extension point. To support a new program, add an
# AppHandler here, or just its command name as a string for a plain relaunch. (Handler
# classes are defined further below.)
def restore_handlers() -> list["AppHandler | str"]:
    return [
        ClaudeHandler(),
        CodexHandler(),
        ArgvHandler("nvim", excluded_flags={"--embed"}),
        ArgvHandler("vim"),
        ArgvHandler("btop"),
        ArgvHandler("htop"),
        ArgvHandler("top"),
    ]


class TmuxSnapError(Exception):
    """An expected, user-facing failure"""


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #


class Cli:
    """Command-line layer: argument parsing, logging setup, and subcommand dispatch."""

    @staticmethod
    def main(argv: list[str] | None = None) -> int:
        args = Cli.build_parser().parse_args(argv)
        Cli.configure_logging(verbose=args.verbose)
        tmux = Tmux.from_args(socket_name=args.socket_name, socket_path=args.socket_path)
        store = SnapshotStore(Cli.default_snapshot_dir())
        try:
            return args.run(args, tmux, store)
        except TmuxSnapError as error:
            log.error("%s", error)
            return 1

    @staticmethod
    def build_parser() -> argparse.ArgumentParser:
        parser = argparse.ArgumentParser(
            prog="tmux-snap", description="Save and restore tmux sessions."
        )
        parser.add_argument("-v", "--verbose", action="store_true", help="enable debug logging")
        sockets = parser.add_mutually_exclusive_group()
        sockets.add_argument(
            "-L", dest="socket_name", metavar="NAME", help="tmux socket name (like tmux -L)"
        )
        sockets.add_argument(
            "-S", dest="socket_path", metavar="PATH", help="tmux socket path (like tmux -S)"
        )
        subcommands = parser.add_subparsers(dest="command", required=True)

        save = subcommands.add_parser("save", help="snapshot a session to JSON")
        save.add_argument("name", nargs="?", help="snapshot name (default: source session name)")
        save.add_argument("--session", metavar="SRC", help="source session when detached")
        save.set_defaults(run=Cli.cmd_save)

        restore = subcommands.add_parser("restore", help="rebuild a session from a snapshot")
        restore.add_argument(
            "name", nargs="?", help="snapshot to restore (default: current session name)"
        )
        restore.add_argument(
            "--no-attach", action="store_true", help="build detached; don't attach/switch"
        )
        restore.add_argument(
            "--replace", action="store_true", help="kill an existing session of that name"
        )
        restore.set_defaults(run=Cli.cmd_restore)

        subcommands.add_parser("list", help="list saved snapshots").set_defaults(run=Cli.cmd_list)

        destroy = subcommands.add_parser("destroy", help="delete a saved snapshot")
        destroy.add_argument("name")
        destroy.set_defaults(run=Cli.cmd_destroy)
        return parser

    @staticmethod
    def configure_logging(*, verbose: bool) -> None:
        log.handlers.clear()
        handler = logging.StreamHandler(sys.stderr)
        handler.setFormatter(logging.Formatter("tmux-snap: %(message)s"))
        log.addHandler(handler)
        log.setLevel(logging.DEBUG if verbose else logging.INFO)

    @staticmethod
    def cmd_save(args: argparse.Namespace, tmux: "Tmux", store: "SnapshotStore") -> int:
        session_name = Cli._resolve_source_session(args, tmux)
        snapshot = Cli._make_snapshotter(tmux).capture(session_name)
        print(store.save(snapshot, args.name or session_name))  # the path is the data output
        return 0

    @staticmethod
    def cmd_restore(args: argparse.Namespace, tmux: "Tmux", store: "SnapshotStore") -> int:
        current = Cli._current_session_name(args, tmux)
        name = args.name or current
        if not name:
            raise TmuxSnapError("not attached to a tmux session; pass the snapshot NAME")
        snapshot = store.load(name)
        snapshotter = Cli._make_snapshotter(tmux)
        size = tmux.viewing_size(current) if current else None
        if args.replace and name == current:
            # We're attached to the session being replaced; killing it directly would drop
            # our client (and the SSH connection). Swap it out from a detached server job.
            Cli._replace_attached(tmux, snapshotter, snapshot, name, size=size)
        else:
            snapshotter.build(snapshot, name=name, replace=args.replace, size=size)
            Cli._attach(tmux, name, no_attach=args.no_attach, current=current)
        return 0

    @staticmethod
    def cmd_list(args: argparse.Namespace, tmux: "Tmux", store: "SnapshotStore") -> int:
        entries = store.entries()
        if not entries:
            log.info("no snapshots in %s", store.directory)
            return 0
        for entry in entries:
            print(entry.describe())  # rows are the data output
        return 0

    @staticmethod
    def cmd_destroy(args: argparse.Namespace, tmux: "Tmux", store: "SnapshotStore") -> int:
        log.info("removed %s", store.destroy(args.name))
        return 0

    @staticmethod
    def _resolve_source_session(args: argparse.Namespace, tmux: "Tmux") -> str:
        name = args.session or Cli._current_session_name(args, tmux)
        if not name:
            raise TmuxSnapError("not attached to a tmux session; pass --session SRC")
        return name

    @staticmethod
    def _current_session_name(args: argparse.Namespace, tmux: "Tmux") -> str | None:
        """The name of the session we are running inside, or None when it can't be inferred
        (detached, or an explicit -L/-S targets a server we're not attached to)."""
        if "TMUX" in os.environ and not (args.socket_name or args.socket_path):
            return tmux.enclosing_session_name()
        return None

    @staticmethod
    def _make_snapshotter(tmux: "Tmux") -> "Snapshotter":
        return Snapshotter(tmux, HandlerRegistry(restore_handlers()), ProcessTree.from_system)

    @staticmethod
    def _attach(tmux: "Tmux", name: str, *, no_attach: bool, current: str | None = None) -> None:
        inside = "TMUX" in os.environ
        same_server = tmux.from_tmux_env or not tmux.socket_args
        if not no_attach and inside and same_server:
            tmux.switch_client(name, from_session=current)
        elif not no_attach and not inside:
            tmux.attach_session(name)
        elif inside and same_server:
            log.info("restored %r (detached); switch with: tmux switch-client -t %s", name, name)
        else:
            socket = (" ".join(tmux.socket_args) + " ") if tmux.socket_args else ""
            log.info("restored %r (detached); attach with: tmux %sattach -t %s", name, socket, name)

    @staticmethod
    def _replace_attached(
        tmux: "Tmux",
        snapshotter: "Snapshotter",
        snapshot: "Snapshot",
        name: str,
        *,
        size: tuple[int, int] | None = None,
    ) -> None:
        # tmux-snap runs in a pane of `name`, so we can't kill `name` from here. Build the
        # restoration in a temp session, move our client onto it, then let a detached server
        # job (which outlives this pane) kill the old session and rename the temp back.
        temp = f"{name}-restore-{os.getpid()}"
        snapshotter.build(snapshot, name=temp, replace=True, size=size)
        tmux.switch_client(temp, from_session=name)
        tmux.detached_replace(old=name, temp=temp)

    @staticmethod
    def default_snapshot_dir() -> Path:
        base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
        return Path(base) / "tmux-snapshots"


# --------------------------------------------------------------------------- #
# Snapshot data model
# --------------------------------------------------------------------------- #


@dataclass(slots=True)
class RestoreAction:
    """How to bring one pane back: which handler, and the state it captured."""

    handler_id: str
    state: dict[str, Any]

    def to_dict(self) -> dict[str, Any]:
        return {"handler": self.handler_id, "state": self.state}

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Self:
        return cls(handler_id=data["handler"], state=data.get("state", {}))


@dataclass(slots=True)
class Pane:
    index: int
    is_active: bool
    cwd: str
    shell_pid: int  # informational
    current_command: str  # informational (tmux pane_current_command)
    restore: RestoreAction | None  # None => leave a plain shell
    # A tmux-nest window displays another session in this pane. That session is stored
    # here in full, so restoring the outer one rebuilds what was inside the nest too.
    nest: "Snapshot | None" = None

    def to_dict(self) -> dict[str, Any]:
        return {
            "index": self.index,
            "active": self.is_active,
            "cwd": self.cwd,
            "shell_pid": self.shell_pid,
            "current_command": self.current_command,
            "restore": self.restore.to_dict() if self.restore else None,
            "nest": self.nest.to_session_dict() if self.nest else None,
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Self:
        action = data.get("restore")
        nest = data.get("nest")
        return cls(
            index=data["index"],
            is_active=data["active"],
            cwd=data["cwd"],
            shell_pid=data.get("shell_pid", 0),
            current_command=data.get("current_command", ""),
            restore=RestoreAction.from_dict(action) if action else None,
            nest=Snapshot.from_session_dict(nest) if nest else None,
        )


@dataclass(slots=True)
class Window:
    index: int
    name: str
    is_active: bool
    layout: str
    is_zoomed: bool
    is_synchronized: bool
    panes: list[Pane]

    def to_dict(self) -> dict[str, Any]:
        return {
            "index": self.index,
            "name": self.name,
            "active": self.is_active,
            "layout": self.layout,
            "zoomed": self.is_zoomed,
            "synchronized": self.is_synchronized,
            "panes": [pane.to_dict() for pane in self.panes],
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Self:
        return cls(
            index=data["index"],
            name=data["name"],
            is_active=data["active"],
            layout=data["layout"],
            is_zoomed=data.get("zoomed", False),
            is_synchronized=data.get("synchronized", False),
            panes=[Pane.from_dict(pane) for pane in data["panes"]],
        )


@dataclass(slots=True)
class Snapshot:
    schema_version: int
    saved_at: str
    session_name: str
    active_window_index: int
    windows: list[Window]

    def to_dict(self) -> dict[str, Any]:
        return {
            "schema_version": self.schema_version,
            "saved_at": self.saved_at,
            **self.to_session_dict(),
        }

    def to_session_dict(self) -> dict[str, Any]:
        """The session on its own, without the file envelope. A snapshot file is this plus
        schema_version/saved_at; a nested session is this stored inside its host pane, where
        repeating the envelope would say nothing the enclosing file doesn't already say."""
        return {
            "session": {"name": self.session_name, "active_window_index": self.active_window_index},
            "windows": [window.to_dict() for window in self.windows],
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Self:
        if data.get("schema_version") != SCHEMA_VERSION:
            raise TmuxSnapError(f"unsupported schema_version {data.get('schema_version')!r}")
        return cls.from_session_dict(data, saved_at=data.get("saved_at", ""))

    @classmethod
    def from_session_dict(cls, data: dict[str, Any], *, saved_at: str = "") -> Self:
        session = data.get("session", {})
        return cls(
            schema_version=SCHEMA_VERSION,
            saved_at=saved_at,
            session_name=session.get("name", ""),
            active_window_index=session.get("active_window_index", 0),
            windows=[Window.from_dict(window) for window in data.get("windows", [])],
        )


# --------------------------------------------------------------------------- #
# Process tree (find the real foreground program behind a pane's shell)
# --------------------------------------------------------------------------- #


@dataclass(slots=True)
class ForegroundProcess:
    pid: int | None  # None for a bare shell
    command: str  # basename of the foreground command
    argv: list[str]


class ProcessArgv:
    """Read a process's exact argv through platform-native interfaces."""

    CTL_KERN = 1
    KERN_ARGMAX = 8
    KERN_PROCARGS2 = 49

    @classmethod
    def read(cls, pid: int) -> list[str]:
        if sys.platform == "linux":
            return cls.linux(pid)
        if sys.platform == "darwin":
            return cls.darwin(pid)
        raise OSError(f"native process argv is unsupported on {sys.platform}")

    @classmethod
    def linux(cls, pid: int, proc_root: Path = Path("/proc")) -> list[str]:
        data = (proc_root / str(pid) / "cmdline").read_bytes()
        return cls._parse_nul_argv(data)

    @classmethod
    def darwin(cls, pid: int) -> list[str]:
        libc = ctypes.CDLL(None, use_errno=True)
        sysctl = libc.sysctl
        sysctl.argtypes = [
            ctypes.POINTER(ctypes.c_int),
            ctypes.c_uint,
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_size_t),
            ctypes.c_void_p,
            ctypes.c_size_t,
        ]
        sysctl.restype = ctypes.c_int

        argmax = ctypes.c_int()
        size = ctypes.c_size_t(ctypes.sizeof(argmax))
        argmax_mib = (ctypes.c_int * 2)(cls.CTL_KERN, cls.KERN_ARGMAX)
        cls._sysctl(sysctl, argmax_mib, ctypes.byref(argmax), size)
        if argmax.value <= 0:
            raise OSError("KERN_ARGMAX returned an invalid size")

        buffer = ctypes.create_string_buffer(argmax.value)
        size = ctypes.c_size_t(argmax.value)
        process_mib = (ctypes.c_int * 3)(cls.CTL_KERN, cls.KERN_PROCARGS2, pid)
        cls._sysctl(sysctl, process_mib, buffer, size)
        return cls._parse_darwin_argv(buffer.raw[: size.value])

    @staticmethod
    def _sysctl(sysctl: Any, mib: Any, output: Any, size: ctypes.c_size_t) -> None:
        if sysctl(mib, len(mib), output, ctypes.byref(size), None, 0) == -1:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))

    @staticmethod
    def _parse_nul_argv(data: bytes) -> list[str]:
        parts = data.split(b"\0")
        if parts and parts[-1] == b"":
            parts.pop()
        return [os.fsdecode(part) for part in parts]

    @classmethod
    def _parse_darwin_argv(cls, data: bytes) -> list[str]:
        int_size = ctypes.sizeof(ctypes.c_int)
        if len(data) < int_size:
            raise ValueError("KERN_PROCARGS2 response is missing argc")
        argc = int.from_bytes(data[:int_size], byteorder=sys.byteorder, signed=True)
        if argc < 0:
            raise ValueError("KERN_PROCARGS2 returned a negative argc")

        payload = data[int_size:]
        executable_end = payload.find(b"\0")
        if executable_end == -1:
            raise ValueError("KERN_PROCARGS2 response is missing the executable path")
        offset = executable_end + 1
        while offset < len(payload) and payload[offset] == 0:
            offset += 1

        argv = cls._parse_nul_argv(payload[offset:])
        if len(argv) < argc:
            raise ValueError("KERN_PROCARGS2 response contains fewer arguments than argc")
        return argv[:argc]


class ProcessTree:
    def __init__(
        self,
        children: dict[int, list[int]],
        commands: dict[int, str],
        argv_reader: Callable[[int], list[str]] | None = None,
    ) -> None:
        self._children = children
        self._commands = commands
        self._argv_reader = argv_reader

    @classmethod
    def from_system(cls) -> Self:
        result = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,command="],
            text=True,
            capture_output=True,
            check=False,
        )
        return cls.from_ps_output(result.stdout, argv_reader=ProcessArgv.read)

    @classmethod
    def from_ps_output(
        cls, output: str, argv_reader: Callable[[int], list[str]] | None = None
    ) -> Self:
        children: dict[int, list[int]] = {}
        commands: dict[int, str] = {}
        for line in output.splitlines():
            parts = line.split(maxsplit=2)
            if len(parts) < 2:
                continue
            pid, parent_pid = int(parts[0]), int(parts[1])
            children.setdefault(parent_pid, []).append(pid)
            commands[pid] = parts[2] if len(parts) == 3 else ""
        return cls(children, commands, argv_reader)

    def foreground(self, shell_pid: int) -> ForegroundProcess:
        """Descend from a pane's shell to its deepest child — the foreground program."""
        lineage = self.lineage(shell_pid)
        if lineage:
            return lineage[-1]
        return ForegroundProcess(
            None, self._command_basename(self._commands.get(shell_pid, "")), []
        )

    def lineage(self, shell_pid: int) -> list[ForegroundProcess]:
        """Processes from the pane shell's direct child down to its deepest descendant."""
        current, seen = shell_pid, set()
        lineage: list[ForegroundProcess] = []
        while self._children.get(current):
            child = max(self._children[current])  # deepest, newest-pid child ≈ foreground
            if child in seen:  # cycle guard (shouldn't happen)
                break
            seen.add(child)
            current = child
            raw = self._commands.get(child, "")
            argv = self._argv(child, raw)
            command = self._command_basename(argv[0]) if argv else ""
            lineage.append(ForegroundProcess(child, command, argv))
        return lineage

    def _argv(self, pid: int, fallback: str) -> list[str]:
        if self._argv_reader is not None:
            try:
                argv = self._argv_reader(pid)
                if argv:
                    return argv
            except (OSError, ValueError):
                pass
        try:
            return shlex.split(fallback)
        except ValueError:
            return fallback.split()

    @staticmethod
    def _command_basename(arg0: str) -> str:
        """Basename of a command's argv[0], with a login shell's leading '-' stripped."""
        if not arg0:
            return ""
        return os.path.basename(arg0.split(" ", 1)[0]).removeprefix("-")


# --------------------------------------------------------------------------- #
# Claude session registry (internal, undocumented — kept defensive)
# --------------------------------------------------------------------------- #


@dataclass(slots=True)
class ClaudeSession:
    session_id: str | None
    name: str | None


class ClaudeRegistry:
    def __init__(self, sessions_dir: Path | None = None) -> None:
        self._dir = sessions_dir or self.default_claude_sessions_dir()

    @staticmethod
    def default_claude_sessions_dir() -> Path:
        return Path.home() / ".claude" / "sessions"

    def lookup(self, foreground_pid: int | None, cwd: str) -> ClaudeSession:
        """sessionId for a running claude: by pid first, else newest registry matching cwd."""
        try:
            if foreground_pid is not None:
                by_pid = self._read(self._dir / f"{foreground_pid}.json")
                if by_pid and by_pid.get("sessionId"):
                    return ClaudeSession(by_pid["sessionId"], by_pid.get("name"))
            newest = self._newest_matching_cwd(cwd)
            if newest is not None:
                return ClaudeSession(newest["sessionId"], newest.get("name"))
        except OSError:
            pass
        return ClaudeSession(None, None)

    def _newest_matching_cwd(self, cwd: str) -> dict[str, Any] | None:
        best_mtime, best = -1.0, None
        for path in self._dir.glob("*.json"):
            data = self._read(path)
            if data and data.get("cwd") == cwd and data.get("sessionId"):
                mtime = path.stat().st_mtime
                if mtime > best_mtime:
                    best_mtime, best = mtime, data
        return best

    @staticmethod
    def _read(path: Path) -> dict[str, Any] | None:
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            return None


# --------------------------------------------------------------------------- #
# Codex session registry (internal JSONL storage — kept defensive)
# --------------------------------------------------------------------------- #


@dataclass(slots=True)
class CodexSession:
    session_id: str | None


class CodexRegistry:
    def __init__(self, sessions_dir: Path | None = None) -> None:
        self._dir = sessions_dir or self.default_codex_sessions_dir()

    @staticmethod
    def default_codex_sessions_dir() -> Path:
        codex_home = os.environ.get("CODEX_HOME")
        return Path(codex_home) / "sessions" if codex_home else Path.home() / ".codex" / "sessions"

    def lookup(self, foreground_pid: int | None, cwd: str) -> CodexSession:
        """Find the active rollout by open file first, then newest matching cwd."""
        try:
            if foreground_pid is not None:
                path = self._rollout_open_by(foreground_pid)
                metadata = self._read_metadata(path) if path else None
                if metadata and metadata.get("session_id"):
                    return CodexSession(metadata["session_id"])
            newest = self._newest_matching_cwd(cwd)
            if newest and newest.get("session_id"):
                return CodexSession(newest["session_id"])
        except OSError:
            pass
        return CodexSession(None)

    def _rollout_open_by(self, pid: int) -> Path | None:
        """Linux can identify the exact rollout even with concurrent sessions in one cwd."""
        fd_dir = Path("/proc") / str(pid) / "fd"
        for descriptor in fd_dir.iterdir():
            try:
                target = descriptor.resolve()
                target.relative_to(self._dir.resolve())
            except (OSError, ValueError):
                continue
            if target.suffix == ".jsonl":
                return target
        return None

    def _newest_matching_cwd(self, cwd: str) -> dict[str, Any] | None:
        best_mtime, best = -1.0, None
        for path in self._dir.glob("**/*.jsonl"):
            metadata = self._read_metadata(path)
            if metadata and metadata.get("cwd") == cwd and metadata.get("session_id"):
                mtime = path.stat().st_mtime
                if mtime > best_mtime:
                    best_mtime, best = mtime, metadata
        return best

    @staticmethod
    def _read_metadata(path: Path) -> dict[str, Any] | None:
        try:
            with path.open() as session_file:
                record = json.loads(session_file.readline())
            if record.get("type") != "session_meta":
                return None
            payload = record.get("payload")
            return payload if isinstance(payload, dict) else None
        except (OSError, ValueError):
            return None


# --------------------------------------------------------------------------- #
# Handlers: detect (save) + capture state (save) + relaunch (restore).
# --------------------------------------------------------------------------- #


@dataclass(slots=True)
class PaneContext:
    foreground_pid: int | None
    cwd: str
    command: str
    argv: list[str]


class AppHandler:
    id: str = ""

    def matches(self, command: str, argv: list[str]) -> bool:
        return command == self.id

    def capture(self, context: PaneContext) -> dict[str, Any] | None:
        return {}  # {} => relaunch bare; None => leave a plain shell

    def build_command(self, state: dict[str, Any]) -> str:
        return self.id

    def restore(self, tmux: "Tmux", target: str, state: dict[str, Any]) -> None:
        tmux.send_keys(target, self.build_command(state))


class CommandHandler(AppHandler):
    """Relaunch a fixed bare command (the app's own name)."""

    def __init__(self, app_id: str) -> None:
        self.id = app_id


class ArgvHandler(CommandHandler):
    """Relaunch an allowlisted command with its original arguments."""

    def __init__(self, app_id: str, excluded_flags: set[str] | None = None) -> None:
        super().__init__(app_id)
        self._excluded_flags = frozenset(excluded_flags or ())

    def matches(self, command: str, argv: list[str]) -> bool:
        flags = {argument.split("=", 1)[0] for argument in argv[1:] if argument.startswith("-")}
        return super().matches(command, argv) and not flags.intersection(self._excluded_flags)

    def capture(self, context: PaneContext) -> dict[str, Any]:
        return {"args": context.argv[1:]}

    def build_command(self, state: dict[str, Any]) -> str:
        return shlex.join([self.id, *state.get("args", [])])


class ClaudeHandler(AppHandler):
    id = "claude"

    # Flags worth re-applying on resume. --resume/--continue are replaced, and
    # --allow-dangerously-skip-permissions is deliberately dropped (don't silently
    # re-enable a permissions bypass across a restore).
    CLAUDE_KEEP_FLAGS = frozenset({"--effort", "--model"})

    def __init__(self, registry: ClaudeRegistry | None = None) -> None:
        self._registry = registry or ClaudeRegistry()

    def capture(self, context: PaneContext) -> dict[str, Any]:
        session = self._registry.lookup(context.foreground_pid, context.cwd)
        return {
            "session_id": session.session_id,
            "name": session.name,
            "flags": self.preserved_claude_flags(context.argv),
        }

    def build_command(self, state: dict[str, Any]) -> str:
        command = "claude"
        if state.get("session_id"):
            command += f" --resume {state['session_id']}"
        elif state.get("name"):
            command += f" --resume {shlex.quote(state['name'])}"
        return " ".join([command, *state.get("flags", [])]).strip()

    @staticmethod
    def preserved_claude_flags(argv: list[str]) -> list[str]:
        kept: list[str] = []
        index = 1
        while index < len(argv):
            token = argv[index]
            if token.split("=", 1)[0] in ClaudeHandler.CLAUDE_KEEP_FLAGS:
                kept.append(token)
                if "=" not in token and index + 1 < len(argv):
                    kept.append(argv[index + 1])
                    index += 1
            index += 1
        return kept


class CodexHandler(AppHandler):
    id = "codex"

    # Preserve user-facing launch choices, but never carry an approvals/sandbox bypass
    # into a restored session.
    CODEX_VALUE_FLAGS = frozenset({"-m", "--model", "-p", "--profile", "--local-provider"})
    CODEX_BOOLEAN_FLAGS = frozenset({"--search", "--no-alt-screen", "--oss"})

    def __init__(self, registry: CodexRegistry | None = None) -> None:
        self._registry = registry or CodexRegistry()

    def capture(self, context: PaneContext) -> dict[str, Any]:
        session = self._registry.lookup(context.foreground_pid, context.cwd)
        return {
            "session_id": session.session_id,
            "flags": self.preserved_codex_flags(context.argv),
        }

    def build_command(self, state: dict[str, Any]) -> str:
        command = "codex"
        if state.get("session_id"):
            command += f" resume {shlex.quote(state['session_id'])}"
        return " ".join([command, *state.get("flags", [])]).strip()

    @staticmethod
    def preserved_codex_flags(argv: list[str]) -> list[str]:
        kept: list[str] = []
        index = 1
        while index < len(argv):
            token = argv[index]
            flag = token.split("=", 1)[0]
            if flag in CodexHandler.CODEX_BOOLEAN_FLAGS:
                kept.append(token)
            elif flag in CodexHandler.CODEX_VALUE_FLAGS:
                kept.append(token)
                if "=" not in token and index + 1 < len(argv):
                    kept.append(argv[index + 1])
                    index += 1
            index += 1
        return kept


class HandlerRegistry:
    def __init__(self, handlers: list[AppHandler | str]) -> None:
        # A bare string is shorthand for a CommandHandler that relaunches that command.
        resolved = [CommandHandler(h) if isinstance(h, str) else h for h in handlers]
        self._handlers = resolved
        self._by_id = {handler.id: handler for handler in resolved}

    def match(self, command: str, argv: list[str]) -> AppHandler | None:
        return next((h for h in self._handlers if h.matches(command, argv)), None)

    def by_id(self, handler_id: str) -> AppHandler | None:
        return self._by_id.get(handler_id)


# --------------------------------------------------------------------------- #
# tmux client (the single place that shells out to tmux)
# --------------------------------------------------------------------------- #


class Tmux:
    # tmux -F field delimiter — ASCII unit separator, absent from paths and names.
    FIELD_SEPARATOR = "\x1f"
    WINDOW_FORMAT = FIELD_SEPARATOR.join(
        [
            "#{window_index}",
            "#{window_name}",
            "#{window_active}",
            "#{window_layout}",
            "#{window_zoomed_flag}",
        ]
    )
    PANE_FORMAT = FIELD_SEPARATOR.join(
        [
            "#{pane_index}",
            "#{pane_active}",
            "#{pane_synchronized}",
            "#{pane_current_path}",
            "#{pane_current_command}",
            "#{pane_pid}",
            "#{@nest-host}",  # tmux-nest sets this on the pane displaying a nested session
        ]
    )

    def __init__(self, socket_args: list[str], *, from_tmux_env: bool = False) -> None:
        self.socket_args = socket_args
        self.from_tmux_env = from_tmux_env

    @classmethod
    def from_args(cls, *, socket_name: str | None, socket_path: str | None) -> Self:
        if socket_name:
            return cls(["-L", socket_name])
        if socket_path:
            return cls(["-S", socket_path])
        enclosing = cls._enclosing_server()
        if enclosing:  # operate on the server we're launched inside
            return cls(["-S", enclosing[0]], from_tmux_env=True)
        return cls([])

    @staticmethod
    def _enclosing_server() -> tuple[str, str] | None:
        """Socket path and session id ("$N") from $TMUX, which tmux sets in every pane it
        starts. None when we aren't running inside tmux at all."""
        value = os.environ.get("TMUX")
        if not value:
            return None
        fields = value.split(",")
        session_id = f"${fields[2]}" if len(fields) > 2 and fields[2].isdigit() else ""
        return fields[0], session_id

    def _run(self, args: list[str], *, capture: bool = True) -> str:
        completed = subprocess.run(
            ["tmux", *self.socket_args, *args],
            text=True,
            capture_output=capture,
            check=False,
        )
        if completed.returncode != 0:
            detail = (completed.stderr or "").strip() if capture else ""
            raise TmuxSnapError(f"`tmux {' '.join(args)}` failed: {detail}")
        return completed.stdout if capture else ""

    def _try_run(self, args: list[str]) -> str | None:
        """Like _run, but a failure is an answer rather than an error."""
        try:
            return self._run(args)
        except TmuxSnapError:
            return None

    def _ok(self, args: list[str]) -> bool:
        return (
            subprocess.run(
                ["tmux", *self.socket_args, *args], capture_output=True, check=False
            ).returncode
            == 0
        )

    def enclosing_session_name(self) -> str | None:
        """The name of the session tmux-snap itself is running in, or None if we can't tell.

        Asking tmux for `#{session_name}` with no target does not answer this. Without a
        target tmux resolves one from the client that issued the command, and a `tmux`
        process talking to the socket is a command client with no session — so tmux answers
        with whichever session was active most recently instead. Nests are ordinary sessions
        on this same server, which makes that answer routinely a nest rather than us.

        Naming a target avoids the guess. $TMUX's session id comes first: tmux writes it for
        every pane it starts and for every popup it opens, naming the session that popup
        belongs to. $TMUX_PANE is only a fallback, despite identifying a pane exactly, because
        a popup does not get one of its own — it inherits whatever $TMUX_PANE the server was
        started with, which points into an unrelated session, or nothing at all. Popups are
        how the S and R key bindings run this. A target that doesn't resolve makes tmux print
        nothing and still exit 0.
        """
        enclosing = self._enclosing_server()
        candidates = [enclosing[1] if enclosing else "", os.environ.get("TMUX_PANE", "")]
        for target in filter(None, candidates):
            name = self._session_name_of(target)
            if name:
                return name
        return None

    def _session_name_of(self, target: str) -> str | None:
        try:
            message = self._run(["display-message", "-t", target, "-p", "#{session_name}"])
        except TmuxSnapError:
            return None
        return message.strip() or None

    def has_session(self, name: str) -> bool:
        return self._ok(["has-session", "-t", f"={name}"])

    def list_windows(self, session: str) -> list[str]:
        return self._run(["list-windows", "-t", session, "-F", self.WINDOW_FORMAT]).splitlines()

    def list_panes(self, window_target: str) -> list[str]:
        return self._run(["list-panes", "-t", window_target, "-F", self.PANE_FORMAT]).splitlines()

    def pane_indexes(self, window_target: str) -> list[int]:
        rows = self._run(["list-panes", "-t", window_target, "-F", "#{pane_index}"]).splitlines()
        return [int(row) for row in rows]

    def new_session(
        self, name: str, window_name: str, cwd: str, *, size: tuple[int, int] | None = None
    ) -> tuple[str, int]:
        """Create the session and report its id along with its first window's index.

        `size` is the size the session will be viewed at. A session built without it is 80x24
        until a client attaches, so saved layouts are applied to the wrong geometry and have to
        be scaled twice — and a nest window attaching from inside such a session drags the live
        nest down to 80x24 along with it.

        Everything built into a session afterwards is addressed by that id. A name is not a
        safe handle: it is matched by prefix and pattern, so building "web" while a session
        "website" exists can act on the wrong one — and a session named "0", which is what a
        first session is called by default, reads as a window index instead of a session in
        any target that isn't session-qualified.
        """
        args = [
            "new-session",
            "-d",
            "-P",
            "-F",
            self.FIELD_SEPARATOR.join(["#{session_id}", "#{window_index}"]),
            "-s",
            name,
            "-n",
            window_name,
            "-c",
            cwd,
        ]
        if size:
            args += ["-x", str(size[0]), "-y", str(size[1])]
        session_id, window_index = self._run(args).strip().split(self.FIELD_SEPARATOR)
        return session_id, int(window_index)

    def new_window(self, session_id: str, window_name: str, cwd: str) -> int:
        args = [
            "new-window",
            "-t",
            # The trailing colon says "a window of this session"; new-window's target is a
            # window, so a bare session would be read as an index to create the window at.
            f"{session_id}:",
            "-P",
            "-F",
            "#{window_index}",
            "-n",
            window_name,
            "-c",
            cwd,
        ]
        return int(self._run(args).strip())

    def split_window(self, window_target: str, cwd: str) -> None:
        self._run(["split-window", "-t", window_target, "-c", cwd])

    def select_layout(self, window_target: str, layout: str) -> None:
        self._run(["select-layout", "-t", window_target, layout])

    def send_keys(self, pane_target: str, command: str) -> None:
        self._run(["send-keys", "-t", pane_target, "--", command, "Enter"])

    def select_pane(self, pane_target: str) -> None:
        self._run(["select-pane", "-t", pane_target])

    def select_window(self, window_target: str) -> None:
        self._run(["select-window", "-t", window_target])

    def zoom_pane(self, pane_target: str) -> None:
        self._run(["resize-pane", "-Z", "-t", pane_target])

    def enable_synchronize(self, window_target: str) -> None:
        self._run(["set-window-option", "-t", window_target, "synchronize-panes", "on"])

    def kill_session(self, name: str) -> None:
        self._run(["kill-session", "-t", f"={name}"])

    def attach_session(self, name: str) -> None:
        self._run(["attach-session", "-t", name], capture=False)

    def switch_client(self, name: str, *, from_session: str | None = None) -> None:
        """Move every client viewing `from_session` onto `name`.

        Without -c, tmux picks a current client the same way it picks a current session, so
        it can move a client that is watching a nest instead of the one that asked. All of
        the old session's clients move: it is about to be replaced or renamed away, and none
        of them should be left watching it.
        """
        clients = self.clients_of(from_session) if from_session else []
        if not clients:
            self._run(["switch-client", "-t", f"={name}"])
            return
        for client in clients:
            self._run(["switch-client", "-c", client, "-t", f"={name}"])

    def clients_of(self, session: str) -> list[str]:
        """The ttys of every client attached to a session; empty when it has none."""
        rows = self._try_run(["list-clients", "-t", f"={session}", "-F", "#{client_tty}"])
        return rows.splitlines() if rows else []

    def viewing_size(self, session: str) -> tuple[int, int] | None:
        """The size a session is being viewed at, or None when nothing is viewing it. The
        smallest client wins, which is the size tmux itself gives the session."""
        fmt = self.FIELD_SEPARATOR.join(["#{client_width}", "#{client_height}"])
        rows = self._try_run(["list-clients", "-t", f"={session}", "-F", fmt]) or ""
        sizes = []
        for row in rows.splitlines():
            width, _, height = row.partition(self.FIELD_SEPARATOR)
            if width.isdigit() and height.isdigit():
                sizes.append((int(width), int(height)))
        if not sizes:
            return None
        # Width and height are taken from whichever client is smallest in that dimension,
        # independently, which is how tmux itself sizes a session with several clients.
        return min(width for width, _ in sizes), min(height for _, height in sizes)

    def respawn_pane(self, pane_target: str, command: str) -> None:
        self._run(["respawn-pane", "-k", "-t", pane_target, command])

    def set_pane_option(self, pane_target: str, option: str, value: str) -> None:
        self._run(["set-option", "-p", "-t", pane_target, option, value])

    def nest_attach_command(self, session_name: str) -> str:
        """The command tmux-nest gives a nest window: the attach itself, as the pane's own
        process, so the window lives exactly as long as the nest.

        TMUX and TMUX_PANE are cleared because tmux refuses to attach a client whose terminal
        is a pane on the same server while they are set. The socket is named explicitly so
        the client lands on this server and not on the default one.
        """
        attach = ["tmux", *self.socket_args, "new-session", "-A", "-s", session_name]
        return shlex.join(["exec", "env", "-u", "TMUX", "-u", "TMUX_PANE", *attach])

    def detached_replace(self, *, old: str, temp: str) -> None:
        """From a background job owned by the tmux server (so it survives the death of the
        caller's pane, which lives in `old`), kill `old` then rename `temp` back to `old`.

        The rename runs whether or not the kill succeeded. Chaining it behind the kill leaves
        the caller sitting on a session still called `<name>-restore-<pid>` in exactly the case
        where `old` is already gone — and a stranded temp name is worse than a rename that
        harmlessly fails because `old` is somehow still there.
        """
        prefix = " ".join(shlex.quote(part) for part in ["tmux", *self.socket_args])
        kill = f"{prefix} kill-session -t {shlex.quote('=' + old)}"
        rename = f"{prefix} rename-session -t {shlex.quote('=' + temp)} {shlex.quote(old)}"
        self._run(["run-shell", "-b", f"{kill}; {rename}"])


# --------------------------------------------------------------------------- #
# Capture / rebuild orchestration
# --------------------------------------------------------------------------- #


class Snapshotter:
    def __init__(
        self, tmux: Tmux, handlers: HandlerRegistry, process_tree_factory: Callable[[], ProcessTree]
    ) -> None:
        self._tmux = tmux
        self._handlers = handlers
        self._process_tree_factory = process_tree_factory

    def capture(self, session_name: str) -> Snapshot:
        snapshot = self._capture_session(session_name, self._process_tree_factory(), ())
        snapshot.saved_at = self._utc_now_iso()  # only the file is dated, not a nested session
        return snapshot

    def _capture_session(
        self, session_name: str, processes: ProcessTree, hosts: tuple[str, ...]
    ) -> Snapshot:
        """Capture one session. `hosts` is the chain of sessions whose nest windows led here,
        which keeps a mis-set @nest-host from sending us round in circles."""
        if not self._tmux.has_session(session_name):
            raise TmuxSnapError(f"no such session: {session_name}")
        windows: list[Window] = []
        active_window_index = 0
        for row in self._tmux.list_windows(session_name):
            window = self._capture_window(session_name, row, processes, (*hosts, session_name))
            if window.is_active:
                active_window_index = window.index
            windows.append(window)
        return Snapshot(
            schema_version=SCHEMA_VERSION,
            saved_at="",
            session_name=session_name,
            active_window_index=active_window_index,
            windows=windows,
        )

    def _capture_window(
        self, session_name: str, row: str, processes: ProcessTree, hosts: tuple[str, ...]
    ) -> Window:
        index_field, name, active, layout, zoomed = row.split(Tmux.FIELD_SEPARATOR)
        index = int(index_field)
        panes, is_synchronized = self._capture_panes(f"{session_name}:{index}", processes, hosts)
        return Window(
            index=index,
            name=name,
            is_active=active == "1",
            layout=layout,
            is_zoomed=zoomed == "1",
            is_synchronized=is_synchronized,
            panes=panes,
        )

    def _capture_panes(
        self, window_target: str, processes: ProcessTree, hosts: tuple[str, ...]
    ) -> tuple[list[Pane], bool]:
        panes: list[Pane] = []
        is_synchronized = False
        for row in self._tmux.list_panes(window_target):
            (
                index_field,
                active,
                sync,
                cwd,
                current_command,
                shell_pid_field,
                nest_host,
            ) = row.split(Tmux.FIELD_SEPARATOR)
            if sync == "1":
                is_synchronized = True
            shell_pid = int(shell_pid_field)
            nest = self._capture_nest(nest_host, current_command, processes, hosts)
            lineage = processes.lineage(shell_pid)
            panes.append(
                Pane(
                    index=int(index_field),
                    is_active=active == "1",
                    cwd=cwd,
                    shell_pid=shell_pid,
                    current_command=current_command,
                    # A nest pane has no program of its own to relaunch: it IS the client.
                    restore=None if nest else self._restore_action(lineage, cwd),
                    nest=nest,
                )
            )
        return panes, is_synchronized

    def _capture_nest(
        self,
        nest_host: str,
        current_command: str,
        processes: ProcessTree,
        hosts: tuple[str, ...],
    ) -> Snapshot | None:
        """The session a tmux-nest window is displaying, captured whole, or None for a pane
        that isn't hosting one we can rebuild.

        The @nest-host pane option is the marker to go by. The process tree cannot find a
        nest: tmux-nest execs the attach, so the pane's own process IS the tmux client and
        has no children for a handler to match against.

        Only nests on this server are captured. `tmux-nest --ssh` marks its pane the same
        way, but what that pane shows is a session on another machine, which there is no way
        to record from here — and rebuilding it as a local session of the same name would be
        worse than leaving a shell.
        """
        if not nest_host:
            return None
        if current_command == "ssh":
            log.debug("pane hosts remote nest %r; it will restore as a shell", nest_host)
            return None
        if nest_host in hosts:
            log.warning("nest %r is hosted by a session it contains; not descending", nest_host)
            return None
        if not self._tmux.has_session(nest_host):
            log.debug("nest %r is no longer a session here; it will restore as a shell", nest_host)
            return None
        return self._capture_session(nest_host, processes, hosts)

    def _restore_action(self, lineage: list[ForegroundProcess], cwd: str) -> RestoreAction | None:
        for process in reversed(lineage):
            handler = self._handlers.match(process.command, process.argv)
            if handler is None:
                continue
            state = handler.capture(PaneContext(process.pid, cwd, process.command, process.argv))
            return None if state is None else RestoreAction(handler.id, state)
        return None

    def build(
        self,
        snapshot: Snapshot,
        *,
        name: str,
        replace: bool,
        size: tuple[int, int] | None = None,
    ) -> None:
        self._build_session(snapshot, name=name, replace=replace, size=size, hosts=())

    def _build_session(
        self,
        snapshot: Snapshot,
        *,
        name: str,
        replace: bool,
        size: tuple[int, int] | None,
        hosts: tuple[str, ...],
    ) -> None:
        if not snapshot.windows:
            raise TmuxSnapError("snapshot has no windows")
        if self._tmux.has_session(name):
            if not replace:
                raise TmuxSnapError(f"session {name!r} already exists (use --replace)")
            self._tmux.kill_session(name)

        nested_hosts = (*hosts, name)
        first, *rest = snapshot.windows
        session_id, first_index = self._tmux.new_session(
            name, first.name, self._safe_cwd(first.panes[0].cwd), size=size
        )
        real_indexes = [first_index]
        self._build_window(session_id, first_index, first, size=size, hosts=nested_hosts)
        for window in rest:
            index = self._tmux.new_window(
                session_id, window.name, self._safe_cwd(window.panes[0].cwd)
            )
            real_indexes.append(index)
            self._build_window(session_id, index, window, size=size, hosts=nested_hosts)

        active_position = next(
            (i for i, window in enumerate(snapshot.windows) if window.is_active), 0
        )
        self._tmux.select_window(f"{session_id}:{real_indexes[active_position]}")

    def _build_window(
        self,
        session_id: str,
        window_index: int,
        window: Window,
        *,
        size: tuple[int, int] | None,
        hosts: tuple[str, ...],
    ) -> None:
        target = f"{session_id}:{window_index}"
        for pane in window.panes[1:]:  # pane 0 exists; create the rest, then apply geometry
            self._tmux.split_window(target, self._safe_cwd(pane.cwd))
        self._tmux.select_layout(target, window.layout)

        # Pane indexes are positional in creation order; read them back to stay
        # base-index-agnostic, then map each saved pane to its real index by position.
        real_indexes = self._tmux.pane_indexes(target)
        for position, pane in enumerate(window.panes):
            if position < len(real_indexes):
                pane_target = f"{target}.{real_indexes[position]}"
                if pane.nest is not None:
                    self._build_nest(pane_target, pane.nest, size=size, hosts=hosts)
                else:
                    self._apply_restore(pane_target, pane.restore)

        active_position = next((i for i, pane in enumerate(window.panes) if pane.is_active), 0)
        active_index = (
            real_indexes[active_position]
            if active_position < len(real_indexes)
            else real_indexes[0]
        )
        self._tmux.select_pane(f"{target}.{active_index}")
        if window.is_zoomed:
            self._tmux.zoom_pane(f"{target}.{active_index}")
        if window.is_synchronized:  # after send-keys, so relaunches don't broadcast
            self._tmux.enable_synchronize(target)

    def _build_nest(
        self,
        pane_target: str,
        nest: Snapshot,
        *,
        size: tuple[int, int] | None,
        hosts: tuple[str, ...],
    ) -> None:
        """Put the nested session back, then make the pane its host again.

        The pane is respawned rather than sent a command line, because tmux-nest's window runs
        the attach as its own process — that is what makes the window close when the nest ends
        instead of falling back to a shell.

        A nest that is still running is reattached, never rebuilt, even under --replace. A
        nest cannot be killed on its own: the pane showing it holds its only client, so killing
        the session closes that window — and a session built entirely out of nest windows, which
        is what a nest launcher looks like, loses every window and is destroyed with them. That
        takes the client down mid-restore. Reattaching also keeps whatever is running in the
        nest, which a snapshot minutes older has no business discarding; a nest that is gone is
        still rebuilt from the snapshot, which is what happens after a reboot.
        """
        if nest.session_name in hosts:
            log.warning(
                "nest %r would contain the session hosting it; leaving a shell in %s",
                nest.session_name,
                pane_target,
            )
            return
        if self._tmux.has_session(nest.session_name):
            log.info("nest %r is still running; reattaching to it", nest.session_name)
        else:
            self._build_session(nest, name=nest.session_name, replace=False, size=size, hosts=hosts)
        self._tmux.respawn_pane(pane_target, self._tmux.nest_attach_command(nest.session_name))
        self._tmux.set_pane_option(pane_target, "@nest-host", nest.session_name)

    def _apply_restore(self, pane_target: str, restore: RestoreAction | None) -> None:
        if restore is None:
            return
        handler = self._handlers.by_id(restore.handler_id)
        if handler is None:
            log.warning(
                "unknown handler %r; leaving a shell in %s", restore.handler_id, pane_target
            )
            return
        handler.restore(self._tmux, pane_target, restore.state)

    @staticmethod
    def _safe_cwd(cwd: str) -> str:
        return cwd if cwd and os.path.isdir(cwd) else str(Path.home())

    @staticmethod
    def _utc_now_iso() -> str:
        return dt.datetime.now(dt.UTC).isoformat()


# --------------------------------------------------------------------------- #
# Snapshot file store
# --------------------------------------------------------------------------- #


@dataclass(slots=True)
class SnapshotInfo:
    name: str
    saved_at: str
    window_count: int
    pane_count: int
    readable: bool

    def describe(self) -> str:
        if not self.readable:
            return f"{self.name}\t(unreadable)"
        return (
            f"{self.name}\t{self.saved_at}\t({self.window_count} windows, {self.pane_count} panes)"
        )


class SnapshotStore:
    def __init__(self, directory: Path) -> None:
        self.directory = directory

    def path(self, name: str) -> Path:
        if "/" in name or name in ("", ".", ".."):
            raise TmuxSnapError(f"invalid snapshot name {name!r}")
        return self.directory / f"{name}.json"

    def save(self, snapshot: Snapshot, name: str) -> Path:
        path = self.path(name)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(snapshot.to_dict(), indent=2) + "\n")
        return path

    def load(self, name: str) -> Snapshot:
        path = self.path(name)
        if not path.is_file():
            raise TmuxSnapError(f"no snapshot named {name!r} ({path})")
        try:
            data = json.loads(path.read_text())
        except ValueError as error:
            raise TmuxSnapError(f"corrupt snapshot {path}: {error}") from error
        return Snapshot.from_dict(data)

    def destroy(self, name: str) -> Path:
        path = self.path(name)
        if not path.is_file():
            raise TmuxSnapError(f"no snapshot named {name!r} ({path})")
        path.unlink()
        return path

    def entries(self) -> list[SnapshotInfo]:
        if not self.directory.is_dir():
            return []
        paths = sorted(self.directory.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        return [self._describe(path) for path in paths]

    @staticmethod
    def _describe(path: Path) -> SnapshotInfo:
        try:
            data = json.loads(path.read_text())
            windows = data.get("windows", [])
            pane_count = sum(len(window.get("panes", [])) for window in windows)
            return SnapshotInfo(
                path.stem, data.get("saved_at", "?"), len(windows), pane_count, True
            )
        except (OSError, ValueError):
            return SnapshotInfo(path.stem, "", 0, 0, False)


if __name__ == "__main__":
    raise SystemExit(Cli.main())
