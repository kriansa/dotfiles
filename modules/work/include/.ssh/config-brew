# Used only by Homebrew, via HOMEBREW_SSH_CONFIG_PATH (see modules/work/init.fish).
# Pins the salsa key for github.com so brew can fetch the private tap; IdentitiesOnly
# stops ssh from offering the agent's other keys, which authenticate as another account.
#
# These options duplicate the ones in core.sshCommand at modules/git-id-work, because brew
# can't see that setting. Keep both in sync: whenever the key or its ssh options change
# there, mirror the change here.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
